  "rules": {
    "zero": "Only observed results can show numeric zero. Degraded/unobserved show — with reason and next action.",
    "freshness": "Source timestamp and observation remain separate. Stale observations cannot issue current-context hints.",
    "hints": "Persist cooldown and snooze across restart. Dismiss, acknowledge and completed action are distinct. Expire on context change.",
    "motion": "No ambient decorative loops. Request motion ends with request, hidden view or reduced motion. Labels remain.",
    "identity": "Square signal anchor + legible product glyph + optional separate companion. Existing voxel illustration is not a claim of canonical theDog likeness.",
    "native": "Map exports into a local namespace; bundle fonts; macOS owns window chrome. Adoption needs separate runtime evidence.",
    "web": "Explicit 2px candidate profile; existing CRM 4/8/12 runtime is reference evidence, not migrated by this export.",
    "calendar": "EventKit proves authorization, selected calendars, observed empty day, timed events and overlap. Offline and remote sync health require a different source. Context is inline; no automatic writes or joining.",
    "disabled": "text-disabled is only for disabled controls; meaningful secondary text uses text-secondary for contrast."
  },
  "motion": [
    {
      "id": "state",
      "label": "Hover / selection",
      "duration": 160,
      "trigger": "interaction",
      "purpose": "Surface and border; no layout shift",
      "reduced": "Static selected surface",
      "sources": [
        "N1",
        "CRM"
      ]
    },
    {
      "id": "route-reveal",
      "label": "Route reveal",
      "duration": 440,
      "trigger": "navigation",
      "purpose": "First entry only",
      "reduced": "Immediate content",
      "sources": [
        "CRM:route-reveal",
        "Inspector:slidein/hmin/cgTipIn"
      ]
    },
    {
      "id": "route-signal-lock",
      "label": "Navigation indicator",
      "duration": 160,
      "trigger": "navigation",
      "purpose": "Underline settles on selected route",
      "reduced": "Selected underline",
      "sources": [
